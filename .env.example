# Copy this file to .env.local and fill in the values (Supabase dashboard -> project settings -> API / Database).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
FW_TICKET_SECRET=replace-with-32-random-bytes-base64url
FW_OPERATOR_SECRET=replace-with-a-separate-32-random-bytes-base64url
CRON_SECRET=replace-with-a-separate-32-random-bytes-base64url
FW_BOARDS_ACCEPTING=true
SUPABASE_DB_PASSWORD=
POSTGRES_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
POSTGRES_URL_POOLED=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
